{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Origami Reader",
  "version": "0.1.0",
  "identifier": "app.origami.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Origami Reader · Beta",
        "width": 1480,
        "height": 950,
        "minWidth": 860,
        "minHeight": 620,
        "backgroundColor": "#17161b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src https: http://oplugin.localhost oplugin:"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 Sov3ryn",
    "publisher": "Sov3ryn",
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Local reader and text-to-speech workspace",
    "resources": {
      "../workers/": "workers/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "gstreamer1.0-plugins-good"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gstreamer1-plugins-good"]
      }
    }
  }
}
