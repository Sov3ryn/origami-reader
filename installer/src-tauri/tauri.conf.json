{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Origami Reader Installer",
  "version": "0.1.0",
  "identifier": "app.origami.setup",
  "build": {"frontendDist": "../dist", "beforeBuildCommand": "npm run build"},
  "app": {
    "windows": [{"title": "Origami Reader Installer", "width": 1200, "height": 900, "minWidth": 920, "minHeight": 720, "backgroundColor": "#17121d"}],
    "security": {"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"}
  },
  "bundle": {"active": false, "copyright": "Copyright (c) 2026 Sov3ryn", "publisher": "Sov3ryn", "icon": ["../../src-tauri/icons/icon.ico", "../../src-tauri/icons/128x128.png"]}
}
